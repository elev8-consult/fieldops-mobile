+  /// When the barcode moves in the frame, aim the lens at the center again.
+  private func watchSubjectArea() {
+    guard let device = captureDeviceInput?.device else {
+      return
+    }
+    focusTask?.cancel()
+    focusTask = Task { [weak self] in
+      let notes = NotificationCenter.default.notifications(
+        named: .AVCaptureDeviceSubjectAreaDidChange,
+        object: device
+      )
+      for await _ in notes {
+        guard let self else { return }
+        self.delegate?.sessionQueue.async {
+          let now = ProcessInfo.processInfo.systemUptime
+          if now - self.lastSubjectFocusAt < 0.45 { return }
+          self.lastSubjectFocusAt = now
+          self.setFocusMode()
+        }
+      }
+    }
+  }
